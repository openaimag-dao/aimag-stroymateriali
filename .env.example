# Supabase: Project Settings → API. Значения кладём в Vercel → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable/anon key>

# Адрес сайта (для ссылок во входящих письмах Supabase Auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Письма покупателю (КП и счёт в PDF) и менеджеру — через Resend. Без ключа письма просто не уходят.
RESEND_API_KEY=
EMAIL_FROM=AIMAG Stroymateriali <sales@aimag.kz>
# Кому слать уведомления о новых КП, счетах и спецификациях (через запятую)
SALES_NOTIFY_EMAIL=

# Реестр для автозаполнения по БИН. По умолчанию stat.gov.kz; можно указать свой прокси, {bin} подставится.
# BIN_LOOKUP_URL=https://old.stat.gov.kz/api/juridical/counter/api/?lang=ru&bin={bin}
